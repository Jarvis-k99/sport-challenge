# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.

# Public — safe to expose in browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — used for admin actions (creating user accounts).
# Get this from Supabase → Settings → API → service_role.
# Never expose this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection for terminal-based SQL work.
# Get from Supabase → Settings → Database → Connection string → URI.
# Used by ./scripts/db.sh.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
